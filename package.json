{
  "name": "scorpion",
  "version": "1.0.0",
  "description": "Scorpion - AI Technical Interview & Meeting Assistant",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/run-electron.js",
    "start:hidden": "node scripts/run-electron.js --start-hidden",
    "dev": "node scripts/run-electron.js --enable-logging",
    "test": "node --test test/*.test.js",
    "build": "node scripts/run-build.js",
    "build:win": "node scripts/run-build.js --win portable",
    "build:installer": "node scripts/run-build.js --win nsis",
    "build:mac": "node scripts/run-build.js --mac",
    "build:linux": "node scripts/run-build.js --linux"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.3.1",
    "regenerator-runtime": "^0.13.11",
    "screenshot-desktop": "^1.15.0",
    "tesseract.js": "^6.0.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.6"
  },
  "build": {
    "appId": "com.scorpion.assistant",
    "productName": "Scorpion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/**/*.{md,map,txt,ts}",
      "!node_modules/**/{test,tests,docs,example,examples}/**/*",
      "!.git/**/*",
      "!dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/screenshot-desktop/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/scorpion.png"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/scorpion.ico",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "publisherName": "Scorpion AI",
      "legalTrademarks": "Scorpion AI",
      "fileAssociations": []
    },
    "portable": {
      "artifactName": "Scorpion.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Scorpion",
      "artifactName": "Scorpion-Setup.exe"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/scorpion.png"
    }
  },
  "author": "Scorpion",
  "license": "MIT"
}
